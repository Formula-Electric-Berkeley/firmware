{
    "version": "2.0.0",
    "windows": {
        "options": {
            "shell": {
                "executable": "cmd.exe",
                "args": ["/d", "/c"]
            }
        }
    },
    "tasks": [
        {
            "type": "cmake",
            "label": "Build BMS",
            "command": "build",
            "targets": ["BMS"],
            "preset": "Debug",
            "group": "build",
            "problemMatcher": []
        },
        {
            "type": "cmake",
            "label": "Build DASH",
            "command": "build",
            "targets": ["DASH"],
            "preset": "Debug",
            "group": "build",
            "problemMatcher": []
        },
        {
            "type": "cmake",
            "label": "Build DART",
            "command": "build",
            "targets": ["DART"],
            "preset": "Debug",
            "group": "build",
            "problemMatcher": []
        },
        {
            "type": "cmake",
            "label": "Build DCU",
            "command": "build",
            "targets": ["DCU"],
            "preset": "Debug",
            "group": "build",
            "problemMatcher": []
        },
        {
            "type": "cmake",
            "label": "Build DCU_Receiver",
            "command": "build",
            "targets": ["DCU_Receiver"],
            "preset": "Debug",
            "group": "build",
            "problemMatcher": []
        },
        {
            "type": "cmake",
            "label": "Build LVPDB",
            "command": "build",
            "targets": ["LVPDB"],
            "preset": "Debug",
            "group": "build",
            "problemMatcher": []
        },
        {
            "type": "cmake",
            "label": "Build PCU",
            "command": "build",
            "targets": ["PCU"],
            "preset": "Debug",
            "group": "build",
            "problemMatcher": []
        },
        {
            "type": "cmake",
            "label": "Build Sensor_Nodes (FRONT)",
            "command": "build",
            "targets": ["Sensor_Nodes_FRONT"],
            "preset": "Debug",
            "group": "build",
            "problemMatcher": [],
            "detail": "Builds build/Debug/Sensor_Nodes/Sensor_Nodes_FRONT.elf"
        },
        {
            "type": "cmake",
            "label": "Build Sensor_Nodes (REAR)",
            "command": "build",
            "targets": ["Sensor_Nodes_REAR"],
            "preset": "Debug",
            "group": "build",
            "problemMatcher": [],
            "detail": "Builds build/Debug/Sensor_Nodes/Sensor_Nodes_REAR.elf"
        },
        {
            "type": "cmake",
            "label": "Build UART",
            "command": "build",
            "targets": ["UART"],
            "preset": "Debug",
            "group": "build",
            "problemMatcher": []
        },
        {
            "type": "cmake",
            "label": "Build UART_TEST",
            "command": "build",
            "targets": ["UART_TEST"],
            "preset": "Debug",
            "group": "build",
            "problemMatcher": []
        },
        {
            "type": "cmake",
            "label": "CMake: Build Selected Target",
            "command": "build",
            "targets": ["${command:cmake.buildTargetName}"],
            "preset": "${command:cmake.activeBuildPresetName}",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "type": "cmake",
            "label": "Build All",
            "command": "build",
            "targets": ["all"],
            "preset": "Debug",
            "group": "build",
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "CubeProg: Flash project (SWD)",
            "command": "${workspaceFolder}/scripts/flash.sh",
            "args": ["-b", "${input:boardName}"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "Flashes the selected board (resolves Sensor_Nodes_FRONT/REAR to the right ELF)"
        },
        {
            "type": "cmake",
            "label": "CMake: clean rebuild",
            "command": "cleanRebuild",
            "targets": ["all"],
            "preset": "${command:cmake.activeBuildPresetName}",
            "group": "build",
            "problemMatcher": [],
            "detail": "CMake template clean rebuild task"
        },
        {
            "type": "shell",
            "label": "CubeProg: List all available communication interfaces",
            "command": "cube",
            "args": ["programmer", "--list"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "Firmware: Bump Board Version",
            "detail": "Bump <BOARD>/VERSION, commit, tag <BOARD>-v<X.Y.Z>, push",
            "command": "bash",
            "args": ["${workspaceFolder}/scripts/bump-version.sh", "${input:bumpBoard}", "${input:bumpType}"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "Firmware: Bump Repo Version",
            "detail": "Bump top-level VERSION, commit, tag v<X.Y.Z>, push",
            "command": "bash",
            "args": ["${workspaceFolder}/scripts/bump-version.sh", "repo", "${input:bumpType}"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "Firmware: Bump All (Common Changed)",
            "detail": "Bump every board + repo + common, tag each, push. Use when common/ changed.",
            "command": "bash",
            "args": ["${workspaceFolder}/scripts/bump-version.sh", "all", "${input:bumpType}", "--yes"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "Firmware: Bump Auto-Detect",
            "detail": "Inspect staged/unstaged diff, bump affected boards (or all if common/ changed), push",
            "command": "bash",
            "args": ["${workspaceFolder}/scripts/bump-version.sh"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "boardName",
            "type": "pickString",
            "description": "Select board to flash",
            "options": ["BMS", "DASH", "DART", "DCU", "DCU_Receiver", "LVPDB", "PCU", "Sensor_Nodes_FRONT", "Sensor_Nodes_REAR", "UART", "UART_TEST"],
        },
        {
            "id": "bumpBoard",
            "type": "pickString",
            "description": "Which board's firmware version to bump",
            "options": ["BMS", "DASH", "DART", "DCU", "DCU_Receiver", "LVPDB", "PCU", "Sensor_Nodes", "UART", "UART_TEST"],
        },
        {
            "id": "bumpType",
            "type": "pickString",
            "description": "Semantic version bump",
            "options": ["patch", "minor", "major"],
            "default": "patch"
        }
    ]
}
